{
  "key": "perkebunan",
  "name": "Tanaman Perkebunan",
  "columns": [
    {
      "key": "luas_panen",
      "label": "Luas Panen (Ha)",
      "group": "Produksi",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "produktivitas",
      "label": "Produktivitas (Ku/Ha)",
      "group": "Produksi",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "kuantum",
      "label": "Produksi (Ton)",
      "group": "Produksi",
      "type": "formula",
      "is_meta": false,
      "formula": "((luas_panen || 0) * (produktivitas || 0)) / 10"
    },
    {
      "key": "harga_produsen",
      "label": "Harga Produsen (Rp/Kg)",
      "type": "numeric",
      "is_meta": false
    },
    {
      "key": "nilai_output_utama",
      "label": "Nilai Produksi (Juta Rp)",
      "type": "formula",
      "is_meta": false,
      "formula": "((kuantum || 0) * (harga_produsen || 0)) / 1000"
    },
    {
      "key": "rasio_output_ikut",
      "label": "Rasio Ikutan",
      "group": "Output Ikutan",
      "type": "numeric",
      "is_meta": false
    },
    {
      "key": "nilai_output_ikut",
      "label": "Nilai Ikutan",
      "group": "Output Ikutan",
      "type": "formula",
      "is_meta": false,
      "formula": "(nilai_output_utama || 0) * (rasio_output_ikut || 0)"
    },
    {
      "key": "output_adh",
      "label": "Output ADH",
      "type": "formula",
      "is_meta": false,
      "formula": "(nilai_output_utama || 0) + (nilai_output_ikut || 0)"
    },
    {
      "key": "rasio_konsumsi_antara",
      "label": "Rasio KA",
      "group": "Konsumsi Antara",
      "type": "numeric",
      "is_meta": false
    },
    {
      "key": "konsumsi_antara",
      "label": "Nilai KA",
      "group": "Konsumsi Antara",
      "type": "formula",
      "is_meta": false,
      "formula": "(output_adh || 0) * (rasio_konsumsi_antara || 0)"
    },
    {
      "key": "nilai_ntb",
      "label": "Nilai Tambah Bruto",
      "type": "formula",
      "is_meta": false,
      "formula": "(output_adh || 0) - (konsumsi_antara || 0)"
    }
  ],
  "display": {
    "nilai_output_utama": true,
    "nilai_output_ikut": true,
    "output_adh": true,
    "konsumsi_antara": true,
    "nilai_ntb": true
  }
}
