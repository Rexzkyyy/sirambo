{
  "key": "peternakan",
  "name": "Peternakan",
  "columns": [
    {
      "key": "pop_awal",
      "label": "Populasi Awal",
      "group": "Kenaikan Stok",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "pop_akhir",
      "label": "Populasi Akhir",
      "group": "Kenaikan Stok",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "ekspor",
      "label": "Ekspor",
      "group": "Kenaikan Stok",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "impor",
      "label": "Impor",
      "group": "Kenaikan Stok",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "jumlah_stok",
      "label": "Jumlah",
      "group": "Kenaikan Stok",
      "type": "formula",
      "is_meta": true,
      "formula": "((pop_akhir || 0) - (pop_awal || 0)) + (ekspor || 0) - (impor || 0)"
    },
    {
      "key": "berat_daging",
      "label": "Berat Daging (Kg)",
      "group": "Pemotongan",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "konversi_karkas",
      "label": "Konv Karkas",
      "group": "Pemotongan",
      "type": "numeric",
      "is_meta": true
    },
    {
      "key": "pemotongan",
      "label": "Pemotongan",
      "group": "Pemotongan",
      "type": "formula",
      "is_meta": true,
      "formula": "(konversi_karkas || 0) !== 0 ? ((berat_daging || 0) / (konversi_karkas || 0)) : 0"
    },
    {
      "key": "kuantum",
      "label": "Kuantum/Total",
      "type": "formula",
      "is_meta": false,
      "formula": "(jumlah_stok || 0) + (pemotongan || 0)"
    },
    {
      "key": "harga_produsen",
      "label": "Harga Produsen",
      "type": "numeric",
      "is_meta": false
    },
    {
      "key": "nilai_output_utama",
      "label": "Nilai Produksi",
      "type": "formula",
      "is_meta": false,
      "formula": "((kuantum || 0) * (harga_produsen || 0)) / 1000000"
    },
    {
      "key": "rasio_output_ikut",
      "label": "Rasio Ikut",
      "group": "Output Ikutan",
      "type": "numeric",
      "is_meta": false
    },
    {
      "key": "nilai_output_ikut",
      "label": "Nilai Ikut",
      "group": "Output Ikutan",
      "type": "formula",
      "is_meta": false,
      "formula": "((nilai_output_utama || 0) * (rasio_output_ikut || 0))"
    },
    {
      "key": "output_adh",
      "label": "Output Total",
      "type": "formula",
      "is_meta": false,
      "formula": "((nilai_output_utama || 0) + (nilai_output_ikut || 0))"
    },
    {
      "key": "rasio_konsumsi_antara",
      "label": "Rasio KA",
      "group": "Konsumsi Antara",
      "type": "numeric",
      "is_meta": false
    },
    {
      "key": "konsumsi_antara",
      "label": "Nilai KA",
      "group": "Konsumsi Antara",
      "type": "formula",
      "is_meta": false,
      "formula": "((output_adh || 0) * (rasio_konsumsi_antara || 0))"
    },
    {
      "key": "nilai_ntb",
      "label": "Nilai Tambah Bruto",
      "type": "formula",
      "is_meta": false,
      "formula": "((output_adh || 0) - (konsumsi_antara || 0))"
    }
  ],
  "display": {
    "nilai_output_utama": true,
    "nilai_output_ikut": true,
    "output_adh": true,
    "konsumsi_antara": true,
    "nilai_ntb": true
  }
}
